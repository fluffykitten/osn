{
  "$comment": "Single source of truth for the 'Exam Notes Sketch' SVG design system. Read by scripts/validate-svg.mjs. Change values here, never inline.",
  "canvas": {
    "width": 800,
    "heightStep": 20,
    "margin": 16,
    "rootClass": "w-full h-auto my-6 rounded-xl border border-slate-200 bg-white",
    "rootStyle": "min-width:560px"
  },
  "colors": {
    "ink": "#1f2937",
    "inkSoft": "#4b5563",
    "paper": "#ffffff",
    "tagFill": "#ececec",
    "metal": "#8a939c",
    "liquid": "#d6f0fb",
    "particleBlue": "#8fd3ef",
    "particleRed": "#f5a3a3",
    "particleYellow": "#fde58a",
    "particleGreen": "#b5efb0",
    "particlePurple": "#cdb8f5",
    "particleOrange": "#fcc68b",
    "particleGrey": "#cfd4d9",
    "actionFill": "#b5efb0",
    "actionStroke": "#3f8f46",
    "accentBlue": "#2f7fc1",
    "accentRed": "#d64545",
    "accentGreen": "#3f8f46"
  },
  "font": {
    "family": "'Comic Neue', ui-sans-serif, system-ui, sans-serif",
    "weight": 700,
    "sizes": [12, 14, 16],
    "letterSpacing": 0.8,
    "lineHeight": { "12": 18, "14": 20, "16": 22 },
    "minLineHeightRatio": 1.35,
    "charWidthEm": 0.68,
    "capHeightEm": 0.72,
    "descentEm": 0.2
  },
  "stroke": {
    "outline": 2,
    "particle": 1.5,
    "pointer": 1.5,
    "tag": 1.5,
    "graphLine": 2.5
  },
  "particle": {
    "radii": [8, 12, 16],
    "minGap": 6,
    "wallClearance": 3
  },
  "textBox": {
    "padding": 12
  }
}
