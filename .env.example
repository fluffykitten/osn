# Gemini AI Configuration — Dapatkan API key dari https://aistudio.google.com/apikey
# Kunci Utama (Single Key / Standard Mode)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Mode Turbo / Multi-Key Tambahan (Otomatis rotasi kuota & fallback saat rate-limit)
VITE_GEMINI_API_KEY_2=your-second-gemini-api-key-here
# Atau daftar kunci terpisah koma:
# VITE_GEMINI_API_KEYS=key1,key2,key3

# Model AI Gemini yang Digunakan (Default: gemini-3.6-flash)
VITE_GEMINI_MODEL=gemini-3.6-flash

# Supabase (Database & Autentikasi Cloud)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Worker Mailer (Notifikasi Pendaftaran Siswa Baru & Admin)
VITE_CLOUDFLARE_MAILER_URL=https://osn-kimia-mailer.your-subdomain.workers.dev

