# ==============================================================================
# OSN KIMIA MASTERY — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi `.env.local` untuk development lokal
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION
# Dapatkan API key gratis dari: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
# Kunci Utama (Wajib untuk koreksi pengerjaan & asisten AI)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Mode Multi-Key Pool (Otomatis rotasi kuota & auto-fallback saat rate-limit HTTP 429/403)
VITE_GEMINI_API_KEY_2=your-second-gemini-api-key-here
VITE_GEMINI_API_KEY_3=your-third-gemini-api-key-here

# Opsi alternatif: Daftar kunci terpisah koma atau spasi
# VITE_GEMINI_API_KEYS=key1,key2,key3

# Model AI Gemini yang Digunakan (Default: gemini-3.6-flash, Alternatif: gemini-2.5-flash, gemini-1.5-flash)
VITE_GEMINI_MODEL=gemini-3.6-flash

# (Opsional) AI Proxy Serverless Endpoint jika menggunakan relay backend
# VITE_AI_PROXY_URL=https://your-domain.com/api/ai

# ------------------------------------------------------------------------------
# 2. SUPABASE CLOUD (DATABASE, AUTENTIKASI, & REALTIME)
# Dapatkan kredensial dari: https://supabase.com/dashboard/project/<project-id>/settings/api
# ------------------------------------------------------------------------------
# URL Proyek Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Aman untuk frontend client browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# (Opsional - KHUSUS ADMINISTRATOR / SKRIP SINKRONISASI)
# Digunakan untuk fitur Admin Portal (auth.admin.inviteUserByEmail) dan skrip sync database.
# PERINGATAN: Jangan sebarkan Service Role Key ke repositori publik.
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE WORKER & R2 STORAGE RELAY (FRONTEND CLIENT)
# URL Worker yang menangani pengiriman email dan penyimpanan berkas R2
# ------------------------------------------------------------------------------
# Cloudflare Worker Mailer (Pengiriman email verifikasi, notifikasi, dan undangan)
VITE_CLOUDFLARE_MAILER_URL=https://osn-kimia-mailer.your-subdomain.workers.dev

# Cloudflare R2 Storage Relay (Penyimpanan berkas gambar soal, diagram, dan avatar)
VITE_CLOUDFLARE_STORAGE_URL=https://osn-kimia-mailer.your-subdomain.workers.dev

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE WORKER ENVIRONMENT VARIABLES (UNTUK DEPLOY WORKER / BACKEND)
# Konfigurasi ini diset via Cloudflare Dashboard / Wrangler Secret untuk `osn-kimia-mailer`
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_your_resend_api_key_here
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# ADMIN_EMAIL=admin@example.com
# SENDER_EMAIL=onboarding@resend.dev
# SENDER_NAME=OSN Kimia Mastery
